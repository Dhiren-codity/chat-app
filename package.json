{
  "name": "chat-app",
  "version": "1.0.0",
  "description": "Multi-language chat application",
  "scripts": {
    "test": "jest --coverage",
    "test:js": "jest --testMatch='**/*.test.js'",
    "test:ts": "jest --testMatch='**/*.test.ts'"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>"],
    "testMatch": [
      "**/*.test.js",
      "**/*.test.ts",
      "**/*.spec.js",
      "**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": "babel-jest"
    },
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/*.test.{js,ts}",
      "!**/*.spec.{js,ts}"
    ]
  }
}
